# Configurações do Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Segurança & CORS (Origens autorizadas separadas por vírgula)
ALLOWED_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5183,http://127.0.0.1:5183
RATE_LIMIT_MAX=60
# Limite separado para blocos de mapa e fotos (o mapa pede dezenas por segundo)
TILE_RATE_LIMIT_MAX=3000

# NASA Upstream Endpoints
NASA_TRAVERSE_URL=https://mars.nasa.gov/mmgis-maps/M20/Layers/json/M20_traverse.json
REQUEST_TIMEOUT_MS=8000

# Pasta do frontend servida na mesma porta (padrão: ../frontend)
# FRONTEND_DIR=/usr/src/app/frontend

# Copiloto ARES (opcional). Sem chave, o copiloto responde no modo local do navegador.
ANTHROPIC_API_KEY=
# COPILOT_MODEL=claude-opus-5-5
